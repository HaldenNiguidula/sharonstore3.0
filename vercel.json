{
  "regions": [
    "sin1"
  ],
  "functions": {
    "api/*.php": {
      "runtime": "vercel-php@0.7.2"
    }
  },
  "routes": [
    {
      "src": "/sharonstore3.0/assets/(.*)",
      "headers": {
        "cache-control": "public, max-age=0, must-revalidate"
      },
      "dest": "/assets/$1"
    },
    {
      "src": "/assets/(.*)",
      "headers": {
        "cache-control": "public, max-age=0, must-revalidate"
      },
      "dest": "/assets/$1"
    },
    {
      "src": "/sharonstore3.0/api/(.*)",
      "dest": "/api/$1"
    },
    {
      "src": "/api/(.*)",
      "dest": "/api/$1"
    },
    {
      "src": "/sharonstore3.0/(.*)",
      "dest": "/api/index.php?file=$1"
    },
    {
      "src": "/sharonstore3.0",
      "dest": "/api/index.php?file=index.php"
    },
    {
      "src": "/(.*)",
      "dest": "/api/index.php?file=$1"
    }
  ]
}
