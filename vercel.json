{
  "functions": {
    "*.php": {
      "runtime": "vercel-php@0.6.1"
    },
    "api/*.php": {
      "runtime": "vercel-php@0.6.1"
    }
  },
  "rewrites": [
    {
      "source": "/sharonstore3.0/assets/:path*",
      "destination": "/assets/:path*"
    },
    {
      "source": "/sharonstore3.0/api/:path*",
      "destination": "/api/:path*"
    },
    {
      "source": "/sharonstore3.0/:page*",
      "destination": "/:page*"
    },
    {
      "source": "/dashboard",
      "destination": "/dashboard.php"
    },
    {
      "source": "/pos",
      "destination": "/pos.php"
    },
    {
      "source": "/inventory",
      "destination": "/inventory.php"
    },
    {
      "source": "/suppliers",
      "destination": "/suppliers.php"
    },
    {
      "source": "/reports",
      "destination": "/reports.php"
    },
    {
      "source": "/shifts",
      "destination": "/shifts.php"
    },
    {
      "source": "/forecasting",
      "destination": "/forecasting.php"
    },
    {
      "source": "/stock-monitor",
      "destination": "/stock-monitor.php"
    },
    {
      "source": "/accounts",
      "destination": "/accounts.php"
    },
    {
      "source": "/audit",
      "destination": "/audit.php"
    },
    {
      "source": "/backup",
      "destination": "/backup.php"
    },
    {
      "source": "/logout",
      "destination": "/logout.php"
    }
  ]
}
