{
  "version": 2,
  "functions": {
    "api/*.php": {
      "runtime": "vercel-php@0.9.0",
      "includeFiles": "{*.php,includes/**,assets/**}"
    }
  },
  "routes": [
    {
      "src": "/sharonstore3.0/assets/(.*)",
      "dest": "/assets/$1"
    },
    {
      "src": "/assets/(.*)",
      "dest": "/assets/$1"
    },
    {
      "src": "/sharonstore3.0/api/(.*)",
      "dest": "/api/$1"
    },
    {
      "src": "/api/(.*)",
      "dest": "/api/$1"
    },
    {
      "src": "/sharonstore3.0/(.*)",
      "dest": "/api/index.php?file=$1"
    },
    {
      "src": "/sharonstore3.0",
      "dest": "/api/index.php?file=index.php"
    },
    {
      "src": "/(.*)",
      "dest": "/api/index.php?file=$1"
    }
  ]
}
